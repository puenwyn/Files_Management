// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ResourceType {
  FOLDER
  FILE
}

enum FolderStatus {
  SHOW
  HIDDEN
}

enum PermissionType {
  VIEW
  EDIT
  SHARE
}

enum ActivityAction {
  CREATE
  UPLOAD
  RENAME
  DELETE
  SHARE
  CHANGE_PERMISSION
}

enum NotificationType {
  SHARE
  CHANGE_PERMISSION
  CREATE
  UPLOAD
  RENAME
  DELETE
}

model User {
  id                    String         @id @default(uuid())
  fullName              String         @db.VarChar(100)
  username              String         @unique @db.VarChar(100)
  hashedPassword        String         @db.VarChar(255)
  email                 String         @unique @db.VarChar(100)
  phoneNumber           String?        @db.VarChar(10)
  bio                   String?        @db.VarChar(500)
  dob                   DateTime?      @db.Date
  gender                String?        @db.VarChar(10)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  refreshTokens         RefreshToken[]
  drives                Drive[]
  acls                  ACL[]
  activities            Activity[]
  notificationsReceived Notification[] @relation("NotificationReceiver")
  notificationsSent     Notification[] @relation("NotificationActor")
}

model RefreshToken {
  id                 String   @id @default(uuid())
  jti                String   @unique
  hashedRefreshToken String   @db.VarChar(255)
  deviceName         String?  @db.VarChar(100)
  ipAddress          String?  @db.VarChar(45)
  userAgent          String?  @db.VarChar(255)
  isRevoked          Boolean  @default(false)
  expiresAt          DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Drive {
  id          String    @id @default(uuid())
  driveName   String    @db.VarChar(255)
  totalSpace  BigInt
  usedSpace   BigInt
  usedPercent Float
  primary     Boolean?  @default(false)
  userId      String
  isDeleted   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  folders Folder[]

  @@index([userId])
}

model Folder {
  id             String       @id @default(uuid())
  folderName     String       @db.VarChar(255)
  parentFolderId String?
  driveId        String?
  status         FolderStatus @default(SHOW)
  passwordHash   String?
  isDeleted      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  drive        Drive?     @relation(fields: [driveId], references: [id], onDelete: Cascade)
  parentFolder Folder?    @relation("FolderChildren", fields: [parentFolderId], references: [id])
  childFolders Folder[]   @relation("FolderChildren")
  acls         ACL[]
  activities   Activity[]

  @@index([parentFolderId])
  @@index([driveId])
}

model ACL {
  id             String         @id @default(uuid())
  userId         String
  folderId       String
  isOwner        Boolean        @default(false)
  permissionType PermissionType
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@unique([userId, folderId])
  @@index([folderId])
}

model Activity {
  id        String         @id @default(uuid())
  userId    String
  action    ActivityAction
  folderId  String?
  metadata  Json?
  createdAt DateTime       @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([folderId])
  @@index([createdAt])
}

model Notification {
  id           String           @id @default(uuid())
  userId       String
  actorUserId  String
  type         NotificationType
  resourceId   String
  resourceType ResourceType
  metadata     Json?
  isRead       Boolean          @default(false)
  createdAt    DateTime         @default(now())

  user  User @relation("NotificationReceiver", fields: [userId], references: [id], onDelete: Cascade)
  actor User @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([resourceId, resourceType])
}
